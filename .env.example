# Antfly Lite locally or the Antfly Cloud Lite instance URL.
# The app adds /db/v1 when it is not already present.
ANTFLY_URL=http://127.0.0.1:8080

# Cloud token only. Leave blank when local Antfly does not require authentication.
ANTFLY_API_KEY=

# A new Lite database exposes this table by default.
ANTFLY_TABLE=default

# Isolates Cortada documents inside the selected table.
CORTADA_NAMESPACE=cortada_dev

ANTFLY_FULL_TEXT_INDEX=full_text_index_v0

# Enable only when the target table has the named Antfly embedding index.
ANTFLY_ENABLE_EMBEDDINGS=false
ANTFLY_EMBEDDING_INDEX=

# Required on Vercel. Optional for localhost development.
CORTADA_BASIC_AUTH_USER=
CORTADA_BASIC_AUTH_PASSWORD=

# Keep false until public traffic controls are configured. When true, Basic Auth
# is bypassed and the application is available to everyone.
CORTADA_PUBLIC_DEMO=false

# Per-instance defense-in-depth limits. Use a distributed firewall or rate
# limiter as the primary public-production control.
CORTADA_INGEST_RATE_LIMIT=5
CORTADA_INGEST_RATE_WINDOW_SECONDS=600
CORTADA_SEARCH_RATE_LIMIT=30
CORTADA_SEARCH_RATE_WINDOW_SECONDS=60

NEXT_PUBLIC_APP_NAME=Cortada
NEXT_PUBLIC_APP_MARK=
NEXT_PUBLIC_APP_EYEBROW=
NEXT_PUBLIC_APP_HEADLINE=
NEXT_PUBLIC_APP_DESCRIPTION=
NEXT_PUBLIC_APP_TITLE=
NEXT_PUBLIC_APP_META_DESCRIPTION=
NEXT_PUBLIC_REPOSITORY_URL=https://github.com/antflydb/cortada
NEXT_PUBLIC_LICENSE_NAME=Apache-2.0
NEXT_PUBLIC_BRAND_PRIMARY="#176b4d"
NEXT_PUBLIC_BRAND_ACCENT="#e66b2e"

# Optional product behavior. Keep the default profile for the published Cortada benchmark.
CORTADA_AUDIT_PROFILE=standard-v1
# Leave blank to derive a crawler identity from the public app name and repository.
CORTADA_FETCH_USER_AGENT=
