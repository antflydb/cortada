FROM node:20-alpine AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:20-alpine AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
ARG NEXT_PUBLIC_APP_NAME
ARG NEXT_PUBLIC_APP_MARK
ARG NEXT_PUBLIC_APP_LOGO_URL
ARG NEXT_PUBLIC_APP_EYEBROW
ARG NEXT_PUBLIC_APP_HEADLINE
ARG NEXT_PUBLIC_APP_DESCRIPTION
ARG NEXT_PUBLIC_APP_DEPLOY_NOTE
ARG NEXT_PUBLIC_APP_FOOTER
ARG NEXT_PUBLIC_APP_TITLE
ARG NEXT_PUBLIC_APP_META_DESCRIPTION
ARG NEXT_PUBLIC_REPOSITORY_URL
ARG NEXT_PUBLIC_LICENSE_NAME
ARG NEXT_PUBLIC_BRAND_PRIMARY
ARG NEXT_PUBLIC_BRAND_ACCENT
ARG NEXT_PUBLIC_BRAND_BACKGROUND
ARG NEXT_PUBLIC_BRAND_SURFACE
ARG NEXT_PUBLIC_BRAND_TEXT
ARG NEXT_PUBLIC_BRAND_MUTED
ARG NEXT_PUBLIC_BRAND_BORDER
ARG NEXT_PUBLIC_THEME_FONT
ARG NEXT_PUBLIC_THEME_CORNERS
ARG NEXT_PUBLIC_SHOW_PROJECT_LINKS
ARG NEXT_PUBLIC_SHOW_ARCHITECTURE
ARG NEXT_PUBLIC_SHOW_ANTFLY_ATTRIBUTION
ENV NEXT_PUBLIC_APP_NAME=$NEXT_PUBLIC_APP_NAME
ENV NEXT_PUBLIC_APP_MARK=$NEXT_PUBLIC_APP_MARK
ENV NEXT_PUBLIC_APP_LOGO_URL=$NEXT_PUBLIC_APP_LOGO_URL
ENV NEXT_PUBLIC_APP_EYEBROW=$NEXT_PUBLIC_APP_EYEBROW
ENV NEXT_PUBLIC_APP_HEADLINE=$NEXT_PUBLIC_APP_HEADLINE
ENV NEXT_PUBLIC_APP_DESCRIPTION=$NEXT_PUBLIC_APP_DESCRIPTION
ENV NEXT_PUBLIC_APP_DEPLOY_NOTE=$NEXT_PUBLIC_APP_DEPLOY_NOTE
ENV NEXT_PUBLIC_APP_FOOTER=$NEXT_PUBLIC_APP_FOOTER
ENV NEXT_PUBLIC_APP_TITLE=$NEXT_PUBLIC_APP_TITLE
ENV NEXT_PUBLIC_APP_META_DESCRIPTION=$NEXT_PUBLIC_APP_META_DESCRIPTION
ENV NEXT_PUBLIC_REPOSITORY_URL=$NEXT_PUBLIC_REPOSITORY_URL
ENV NEXT_PUBLIC_LICENSE_NAME=$NEXT_PUBLIC_LICENSE_NAME
ENV NEXT_PUBLIC_BRAND_PRIMARY=$NEXT_PUBLIC_BRAND_PRIMARY
ENV NEXT_PUBLIC_BRAND_ACCENT=$NEXT_PUBLIC_BRAND_ACCENT
ENV NEXT_PUBLIC_BRAND_BACKGROUND=$NEXT_PUBLIC_BRAND_BACKGROUND
ENV NEXT_PUBLIC_BRAND_SURFACE=$NEXT_PUBLIC_BRAND_SURFACE
ENV NEXT_PUBLIC_BRAND_TEXT=$NEXT_PUBLIC_BRAND_TEXT
ENV NEXT_PUBLIC_BRAND_MUTED=$NEXT_PUBLIC_BRAND_MUTED
ENV NEXT_PUBLIC_BRAND_BORDER=$NEXT_PUBLIC_BRAND_BORDER
ENV NEXT_PUBLIC_THEME_FONT=$NEXT_PUBLIC_THEME_FONT
ENV NEXT_PUBLIC_THEME_CORNERS=$NEXT_PUBLIC_THEME_CORNERS
ENV NEXT_PUBLIC_SHOW_PROJECT_LINKS=$NEXT_PUBLIC_SHOW_PROJECT_LINKS
ENV NEXT_PUBLIC_SHOW_ARCHITECTURE=$NEXT_PUBLIC_SHOW_ARCHITECTURE
ENV NEXT_PUBLIC_SHOW_ANTFLY_ATTRIBUTION=$NEXT_PUBLIC_SHOW_ANTFLY_ATTRIBUTION
COPY --from=dependencies /app/node_modules ./node_modules
COPY . .
RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
